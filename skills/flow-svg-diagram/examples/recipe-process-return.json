{
  "version": 1,
  "title": "审查分支与返回配方 · 教学设定",
  "theme": "light",
  "viewport": {
    "width": 1160,
    "height": 600
  },
  "typography": {
    "nodeLabel": 24,
    "edgeLabel": 22,
    "flowLabel": 18
  },
  "nodes": [
    {
      "id": "collect",
      "kind": "roundedRect",
      "x": 40,
      "y": 120,
      "width": 180,
      "height": 90,
      "label": "收集资料"
    },
    {
      "id": "review",
      "kind": "roundedRect",
      "x": 400,
      "y": 120,
      "width": 180,
      "height": 90,
      "label": "审查资料"
    },
    {
      "id": "archive",
      "kind": "roundedRect",
      "x": 940,
      "y": 120,
      "width": 180,
      "height": 90,
      "label": "归档资料"
    },
    {
      "id": "revise",
      "kind": "roundedRect",
      "x": 400,
      "y": 440,
      "width": 180,
      "height": 90,
      "label": "修改资料"
    }
  ],
  "edges": [
    {
      "id": "submit",
      "from": "collect",
      "to": "review",
      "fromPort": "right",
      "toPort": "left",
      "label": "提交审查"
    },
    {
      "id": "approved",
      "from": "review",
      "to": "archive",
      "fromPort": "right",
      "toPort": "left",
      "label": "通过"
    },
    {
      "id": "changes",
      "from": "review",
      "to": "revise",
      "fromPort": "bottom",
      "toPort": "top",
      "label": "需修改"
    },
    {
      "id": "resubmit",
      "from": "revise",
      "to": "review",
      "fromPort": "left",
      "toPort": "left",
      "route": "curved",
      "label": "再次提交"
    }
  ],
  "scenes": []
}
