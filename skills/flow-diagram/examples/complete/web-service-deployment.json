  "scenes": [
    {
      "id": "entry",
      "label": "Public request entry",
      "beats": [
        {
          "durationMs": 2000,
          "caption": "The browser requests O101 over HTTPS through one public entry. Groups represent runtime locations and network boundaries, not task steps.",
          "actions": [
            {
              "type": "flow",
              "target": "https",
              "direction": "forward",
              "text": "HTTPS"
            }
          ]
        },
        {
          "durationMs": 2000,
          "caption": "The public entry forwards to the load balancer. Both app replicas run the same application; they are not distinct business services. No availability-zone placement is promised.",
          "actions": [
            {
              "type": "flow",
              "target": "entry-route",
              "direction": "forward",
              "text": "Request"
            }
          ]
        }
      ]
    },
    {
      "id": "application",
      "label": "Request reaches replica A",
      "beats": [
        {
          "durationMs": 2000,
          "caption": "The load balancer selects healthy app replica A for this request. The private network contains application and data tiers; the browser cannot access the database directly.",
          "actions": [
            {
              "type": "flow",
              "target": "route-a",
              "direction": "forward",
              "text": "A"
            }
          ]
        }
      ]
    },
    {
      "id": "query",
      "label": "Cache and database reads",
      "beats": [
        {
          "durationMs": 2000,
          "caption": "App replica A checks the cache first. This teaching sample assumes a miss, so the app then reads the database primary.",
          "actions": [
            {
              "type": "flow",
              "target": "cache-read",
              "direction": "forward",
              "text": "Cache read"
            }
          ]
        },
        {
          "durationMs": 2000,
          "caption": "App replica A queries O101 from the primary. This read does not use the read replica, and the application does not write to that replica.",
          "actions": [
            {
              "type": "flow",
              "target": "database-read",
              "direction": "forward",
              "text": "Read O101"
            }
          ]
        },
        {
          "durationMs": 2000,
          "caption": "The primary returns O101. Arrows distinguish query and response directions. Connections indicate reachability, not actual latency.",
          "actions": [
            {
              "type": "flow",
              "target": "database-read",
              "direction": "reverse",
              "text": "Order record"
            }
          ]
        }
      ]
    },
    {
      "id": "response",
      "label": "Return through the entry",
      "beats": [
        {
          "durationMs": 2000,
          "caption": "Replica A finishes the query. The response travels through the load balancer and public entry to the browser. Three simultaneous return transfers illustrate the path.",
          "actions": [
            {
              "type": "flow",
              "target": "route-a",
              "direction": "reverse",
              "text": "Response"
            },
            {
              "type": "flow",
              "target": "entry-route",
              "direction": "reverse",
              "text": "Response"
            },
            {
              "type": "flow",
              "target": "https",
              "direction": "reverse",
              "text": "Response"
            }
          ]
        }
      ]
    },
    {
      "id": "replication",
      "label": "Independent database replication",
      "beats": [
        {
          "durationMs": 2000,
          "caption": "An independent background relationship copies existing writes from the primary to its read replica. The preceding read did not trigger these writes. This does not promise synchronous acknowledgement or automatic database failover.",
          "actions": [
            {
              "type": "flow",
              "target": "replication",
              "direction": "forward",
              "text": "Existing writes"
            }
          ]
        }
      ]
    },
    {
      "id": "health",
      "label": "Health status changes",
      "beats": [
        {
          "durationMs": 2000,
          "caption": "A scripted health check marks replica A unhealthy. This is a fixed teaching action, not live monitoring; the completed query is unaffected by this later event.",
          "actions": [
            {
              "type": "flow",
              "target": "health-a",
              "direction": "forward",
              "text": "Failed"
            },
            {
              "type": "updateNode",
              "target": "app-a",
              "value": {
                "content": {
                  "style": {
                    "padding": 12,
                    "blockGap": 6
                  },
                  "blocks": [
                    {
                      "type": "title",
                      "text": "App replica A"
                    },
                    {
                      "type": "list",
                      "items": [
                        {
                          "tags": [
                            {
                              "text": "Unhealthy",
                              "style": {
                                "shape": "pill",
                                "fontSize": 12
                              }
                            }
                          ]
                        }
                      ]
                    },
                    {
                      "type": "paragraph",
                      "text": "Stop new requests"
                    },
                    {
                      "type": "paragraph",
                      "role": "auxiliary",
                      "text": "Scripted · not live"
                    }
                  ]
                }
              }
            }
          ]
        }
      ]
    },
    {
      "id": "reroute",
      "label": "Route later requests to B",
      "beats": [
        {
          "durationMs": 2000,
          "caption": "Later requests go to healthy replica B instead of unhealthy A. This illustrates app traffic routing, not database failover, autoscaling or cross-region disaster recovery.",
          "actions": [
            {
              "type": "flow",
              "target": "route-b",
              "direction": "forward",
              "text": "B"
            }
          ]
        }
      ]
    }
  ]
}
