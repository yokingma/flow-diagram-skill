  "scenes": [
    {
      "id": "request",
      "label": "Request reaches the API",
      "beats": [
        {
          "durationMs": 2500,
          "caption": "Read from top to bottom. The client requests order O101; the API uses cache-aside reads. This is one fixed teaching request.",
