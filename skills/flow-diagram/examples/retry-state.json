{
  "version": 1,
  "title": "教学示例：有限重试的状态迁移",
  "theme": "light",
  "viewport": {
    "width": 1100,
    "height": 530
  },
  "nodes": [
    {
      "id": "ready",
      "kind": "roundedRect",
      "x": 30,
      "y": 60,
      "width": 170,
      "height": 90,
      "label": "待处理"
    },
    {
      "id": "attempt",
      "kind": "roundedRect",
      "x": 310,
      "y": 60,
      "width": 170,
      "height": 90,
      "label": "执行尝试"
    },
    {
      "id": "success",
      "kind": "roundedRect",
      "x": 900,
      "y": 60,
      "width": 170,
      "height": 90,
      "label": "成功结束"
    },
    {
      "id": "retry",
      "kind": "roundedRect",
      "x": 500,
      "y": 380,
      "width": 170,
      "height": 90,
      "label": "等待重试"
    },
    {
      "id": "failed",
      "kind": "roundedRect",
      "x": 900,
      "y": 380,
      "width": 170,
      "height": 90,
      "label": "失败结束"
    }
  ],
  "edges": [
    {
      "id": "start",
      "from": "ready",
      "to": "attempt",
      "label": "开始",
      "fromPort": "right",
      "toPort": "left",
      "route": "straight"
    },
    {
      "id": "ok",
      "from": "attempt",
      "to": "success",
      "label": "成功",
      "fromPort": "right",
      "toPort": "left",
      "route": "straight"
    },
    {
      "id": "temporary",
      "from": "attempt",
      "to": "retry",
      "label": "临时错误且次数 < 3",
      "fromPort": "bottom",
      "toPort": "top",
      "route": "straight"
    },
    {
      "id": "again",
      "from": "retry",
      "to": "attempt",
      "label": "等待后再次尝试",
      "fromPort": "left",
      "toPort": "left",
      "route": "curved"
    },
    {
      "id": "exhausted",
      "from": "attempt",
      "to": "failed",
      "label": "临时错误且次数 = 3；停止",
      "fromPort": "right",
      "toPort": "top",
      "route": "straight"
    }
  ],
  "scenes": [],
  "typography": {
    "nodeLabel": 22,
    "edgeLabel": 20,
    "flowLabel": 18
  }
}
